{
  "name": "keyturn-relay",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "account_id": "8de5ba9bfe4d7e243568e042f0f1a25c",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "CHANNEL", "class_name": "Channel" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Channel"] }],
  "routes": [{ "pattern": "keys.aiforge.uk", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": false }
}
